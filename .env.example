# Groundwork — Environment Variables
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# See docs/IMPLEMENTATION_PLAN.md for setup instructions.

# ──────────────────────────────────────────────
# Browser-exposed values (safe only with RLS)
# ──────────────────────────────────────────────
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-publishable-anon-key>

# ──────────────────────────────────────────────
# IMPORTANT — DO NOT add these as VITE_ variables
# ──────────────────────────────────────────────
# Supabase service_role key → used only server-side / in migrations
# BYOK provider keys → entered by each user at runtime, never in .env
# Google OAuth secret → configured in Supabase dashboard, not in frontend
